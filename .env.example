# Google Cloud
GCP_PROJECT_ID=cortexiom-orchestrator
GCP_REGION=us-central1
GCS_BUCKET_NAME=cortexiom-orchestrator-data

# Cortexiom API — get your key at developers.cortexiom.com
CORTEXIOM_API_KEY=cx_live_your_key_here
CORTEXIOM_API_URL=https://api.cortexiom.com/v1/encounter

# Vertex AI Search (optional — fill in after creating the data store in GCP console)
# Leave blank to use the local file-based evidence retrieval fallback
VERTEX_AI_SEARCH_DATA_STORE_ID=